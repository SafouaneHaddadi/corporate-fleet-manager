  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set Basic Auth credentials automatically",
          "const username = pm.variables.get('username');",
          "const password = pm.variables.get('password');",
          "const base64Credentials = btoa(username + ':' + password);",
          "pm.request.headers.add({",
          "  key: 'Authorization',",
          "  value: 'Basic ' + base64Credentials",
          "});",
          "",
          "// Log which user is being used",
          "console.log('Using credentials for user:', username);"
        ]
      }
    }
  ],
