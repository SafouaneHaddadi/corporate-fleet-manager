<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <persistence-unit name="fleet-pu" transaction-type="JTA">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:jboss/datasources/OracleFleetDS</jta-data-source> <!-- Nom JNDI du datasource déployé via fleet-ds.xml -->

        <!-- On ajoutera ici toutes nos classes @Entity -->
<!--        <class>be.condorcet.model.Vehicule</class>-->

        <properties>
            <!-- Dialecte Oracle (Hibernate le détecte souvent seul, mais au cas où) -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.OracleDialect" />
            <!-- Met à jour le schéma sans tout supprimer à chaque redéploiement -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- Affiche le SQL dans la console WildFly (pratique pour débugger) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
